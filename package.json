{
  "name": "just_ai_i18n_docgen",
  "private": true,
  "version": "0.1.0",
  "description": "Translate i18n catalogues with a verifying AI pipeline.",
  "productName": "Just AI i18n & DocGen",
  "author": "delebash",
  "license": "MIT",
  "homepage": "https://delebash.github.io/just-ai-i18n-docgen-website/",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "build": "quasar build -m electron",
    "build:spa": "quasar build",
    "build:unpacked": "quasar build -m electron --skip-pkg",
    "postinstall": "quasar prepare --silent",
    "server": "node scripts/node24.js server/src/serve.js serve",
    "test:server": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js",
    "lint": "biome check .",
    "test": "npm test --prefix e2e",
    "screenshots": "node e2e/capture-direct.js",
    "test:unit": "vitest run",
    "cli": "node scripts/node24.js server/src/cli.js",
    "bump": "node scripts/bump.js",
    "release": "node scripts/release.js",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.{js,vue}\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"{src/i18n/locales,../just-core/packages/ui/src/i18n/locales}/en.json\" --exclude kit."
  },
  "dependencies": {
    "@delebash/core": "file:../just-core/packages/core",
    "@quasar/extras": "^2.1.0",
    "github-slugger": "^2.0.0",
    "quasar": "^2.35.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/compat": "^2.1.1",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/number": "^3.6.9",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/message-compiler": "11.4.14",
    "@quasar/app-vite": "^3.10.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "autoprefixer": "^10.6.1",
    "dictionary-es": "^4.0.0",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "^3.4.17",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "front-matter": "^4.0.2",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "nspell": "^2.1.5",
    "pinia": "^4.0.3",
    "postcss": "^8.5.29",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.14",
    "vue-i18n-extract": "^2.0.7",
    "vue-router": "^5.4.0"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true,
    "esbuild": true,
    "@parcel/watcher": true
  }
}
